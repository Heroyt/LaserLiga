{parameters
    App\Models\Booking\BookingSubtypeField $field,
    bool|null $value = null,
}
{var string $id = $field->getId()}

<div class="form-group">
	<div class="form-check form-switch">
		<input class="form-check-input"
               type="checkbox"
               role="switch"
               value="1"
               id="{$id}"
                n:attr="required: $field->required, name: $field->getName(), checked: (bool) $value">
		<label class="form-check-label" for="{$id}">{$field->getTranslatedLabel()}</label>
		<div class="invalid-feedback"></div>
	</div>
	<div n:if="$field->description" id="{$id}-description" class="form-text">{$field->getTranslatedDescription()}</div>
</div>