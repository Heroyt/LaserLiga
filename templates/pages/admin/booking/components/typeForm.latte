{parameters string|int $id, \App\Models\Booking\BookingType|null $type = null, \Google\Service\Calendar\CalendarListEntry[] $calendars = []}

<div class="booking-type card m-3" data-id="{$id}">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="form-floating">
            <input type="text" name="types[{$id}][name]"
                   class="form-control"
                   id="type-{$id}-name"
                   value="{$type?->name ?? ''}"
                   maxlength="50"
                   placeholder="{_'Název typu'}">
            <label for="type-{$id}-name">{_'Název typu'}</label>
        </div>
        <button type="button" class="btn btn-danger delete">
            {faSolid 'trash'}
            <span>{_'Smazat'}</span>
        </button>
    </div>
    <div class="card-body">
        <div class="form-floating mb-3">
            <input type="number" min="1" max="9999" name="types[{$id}][slotLength]"
                   class="form-control"
                   id="type-{$id}-slotLength"
                   value="{$type?->slotLength ?? 30}"
                   placeholder="{_'Délka rezervace (min)', context: 'booking'}">
            <label for="type-{$id}-slotLength">{_'Délka rezervace (min)', context: 'booking'}</label>
        </div>
        <div class="form-floating mb-3">
            <input type="number" min="1" max="9999" name="types[{$id}][slotLimit]"
                   class="form-control"
                   id="type-{$id}-slotLimit"
                   value="{$type?->slotLimit ?? 11}"
                   placeholder="{_'Maximální počet hráčů', context: 'booking'}">
            <label for="type-{$id}-slotLimit">{_'Maximální počet hráčů', context: 'booking'}</label>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" name="types[{$id}][openable]"
                   id="type-{$id}-openable"
                    n:attr="checked: ($type?->openable ?? true)">
            <label class="form-check-label" for="type-{$id}-openable">
                {_'Povolit uzavření rezervace', context: 'booking'}
            </label>
        </div>
        <div class="form-floating mb-3">
            <input type="number" min="0" max="9999" name="types[{$id}][openableMin]"
                   class="form-control"
                   id="type-{$id}-openableMin"
                   value="{$type?->openableMin ?? 0}"
                   placeholder="{_'Minimální počet hráčů pro uzavření rezervace', context: 'booking'}">
            <label for="type-{$id}-openableMin">{_'Minimální počet hráčů pro uzavření rezervace', context: 'booking'}</label>
        </div>
        <div class="form-floating mb-3" n:if="count($calendars) > 0">
            <select class="form-select" name="types[{$id}][calendarId]" id="type-{$id}-calendarId"
                    aria-label="{_'Propojení s Google Kalendářem', context: 'booking'}">
                <option value="">{_'Žádný', context: 'booking'}</option>
                {foreach $calendars as $calendar}
                    <option value="{$calendar->getId()}"
                            n:attr="selected: ($type?->calendarId === $calendar->getId())">
                        {$calendar->getSummary()}
                    </option>
                {/foreach}
            </select>
            <label for="type-{$id}-calendarId">{_'Propojení s Google Kalendářem', context: 'booking'}</label>
        </div>
    </div>
</div>